# ─── App ───
NODE_ENV=development
PORT=3000

# ─── MongoDB ───
MONGO_URI=mongodb://root:secret@mongo:27017/nins?authSource=admin

# ─── MongoDB Replica Set (optional — for production scaling) ───
# MONGO_URI=mongodb://user:pass@mongo1:27017,mongo2:27017,mongo3:27017/nins?replicaSet=rs0&authSource=admin
# MONGO_READ_PREFERENCE=secondaryPreferred

# ─── Database Pool (optimized for 4 vCPU / 8GB RAM) ───
DB_POOL_SIZE=100
DB_MIN_POOL_SIZE=20

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_EXPIRES_IN=7d

# ─── SSLCommerz Payment Gateway ───
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_LIVE=false
APPOINTMENT_FEE=50
BACKEND_URL=http://localhost:3000

# ─── Email (Resend) ───
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=NINS Hospital <onboarding@resend.dev>

# ─── Cloudflare R2 (file storage) ───
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nins-uploads
R2_PUBLIC_BASE_URL=
