# ─── App ───
NODE_ENV=development
PORT=3000

# ─── MongoDB ───
MONGO_URI=mongodb://root:secret@mongo:27017/nins?authSource=admin

# ─── MongoDB Replica Set (optional — for production scaling) ───
# MONGO_URI=mongodb://user:pass@mongo1:27017,mongo2:27017,mongo3:27017/nins?replicaSet=rs0&authSource=admin
# MONGO_READ_PREFERENCE=secondaryPreferred

# ─── Database Pool (optimized for 4 vCPU / 8GB RAM) ───
DB_POOL_SIZE=100
DB_MIN_POOL_SIZE=20

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_EXPIRES_IN=7d
