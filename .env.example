# ─── App ───
NODE_ENV=production
PORT=3000

# ─── MongoDB (Dokploy will provide this) ───
# After adding MongoDB in Dokploy dashboard,
# copy the connection string here or set in Dokploy env vars
MONGO_URI=mongodb://root:secret@mongo:27017/nins?authSource=admin

# ─── JWT (add when auth is implemented) ───
# JWT_SECRET=change-me-to-a-strong-secret
# JWT_EXPIRES_IN=7d
